{
  "name": "ruijinen-block-patterns",
  "description": "類人猿ブロックパターンプラグインのパッケージ",
  "author": "mgn",
  "license": "GPL-2.0+",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "export:wp-content:themes": "npm run cli cp -- -r wp-content/themes .export/wp-content",
    "export:wp-content:uploads": "npm run cli cp -- -r wp-content/uploads .export/wp-content",
    "export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
    "export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
    "export": "run-p export:*",
    "import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes wp-content",
    "import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads wp-content",
    "import:wp-content": "run-p import:wp-content:*",
    "import:db": "npm run wp db -- import .export/sql/local.sql",
    "import": "run-p import:*",
    "wp-env": "wp-env",
    "start": "wp-env start && open http://localhost:1001",
    "stop": "npm run export && wp-env stop",
    "cli": "wp-env run cli",
    "wp": "wp-env run cli wp",
    "clean": "run-s \"clean:*\"",
    "clean:all": "del-cli dist",
    "build": "run-s clean \"build:*\"",
    "build:sass": "sass src/css:dist/css block-styles:dist/css/block-styles --no-error-css --no-source-map",
    "build:postcss": "postcss dist/css --base ./dist/css -d dist/css",
    "build:img": "node optimize-images.mjs",
    "debug:css": "sass src/css:dist/css block-styles:dist/css/block-styles",
    "watch": "run-p \"watch:*\"",
    "watch:sass": "sass src/css:dist/css block-styles:dist/css/block-styles --no-error-css --no-source-map --watch",
    "watch:postcss": "postcss dist/css --base ./dist/css -d dist/css --watch",
    "test:e2e:setup": "wp-env run cli -- bash -c \"wp user get e2e-admin >/dev/null 2>&1 || wp user create e2e-admin e2e-admin@example.com --role=administrator; wp user update e2e-admin --user_pass=password --skip-email; wp user meta update e2e-admin locale en_US\"",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:visual": "playwright test --config tests/visual/playwright.config.js",
    "test:visual:update": "playwright test --config tests/visual/playwright.config.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/e2e-test-utils-playwright": "^3.2.0",
    "@wordpress/env": "^12.1.0",
    "cssnano": "^9.9.0",
    "del-cli": "^8.0.1",
    "glob": "^14.0.3",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-sort-media-queries": "^6.7.1",
    "postcss-sorting": "^10.0.0",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not < 0.5%",
    "not ie <= 11",
    "iOS >= 12",
    "Android >= 7"
  ],
  "overrides": {
    "qs": "^6.16.1",
    "isomorphic-git": "^1.38.6",
    "@wordpress/env": {
      "rimraf": "^6.1.4"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fs-ext-extra-prebuilt": false
  }
}
